# Placeholders only. Real values live in Vercel env / .env.local (gitignored). Never commit a key.

# bMusic artist programme (bwalletX docs/ARTIST-PROGRAMME.md). '1' = on. Off by default.
BMUSIC_ARTIST_PROGRAMME=
# Referral payouts batch job. '1' = on. Off by default.
BMUSIC_REFERRAL_PAYOUTS=

# Fee pot: network fees on us (bwalletX docs/FEE-POT.md). '1' = on. Off by default.
FEE_POT_ENABLED=
# The fee pot's private key (WIF). The owner generates and funds it. Read only at runtime.
FEE_POT_WIF=your-fee-pot-wif-here
# Monthly budget in US dollars, converted to sats at reserve time from the price feed (default 10).
FEE_POT_MONTHLY_USD=10
# Hard monthly ceiling in sats whatever the price says (default 100000000 = 1 BSV).
FEE_POT_MAX_MONTHLY_SATS=100000000
